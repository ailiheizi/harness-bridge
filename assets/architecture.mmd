flowchart TB
  accTitle: Harness Bridge system overview
  accDescr: A trusted application calls the bridge library in its own process. The bridge uses the OpenShell native CLI to run existing DSH in a fresh Docker sandbox. The host keeps storage and user delivery; the bridge returns execution and cleanup evidence.

  subgraph app["Your application · trusted process"]
    direction LR
    Host["Bot / API<br/>Event receiver"]
    Bridge["Harness Bridge<br/>Task lifecycle"]
    Host <-->|trusted task / gated result| Bridge
  end

  subgraph upstream["Reused OpenShell · Docker only"]
    direction LR
    Native["OpenShell<br/>Native control plane"]
    DSH["Fresh task sandbox<br/>Existing DSH + Skill + tools"]
    Native <-->|exec / events| DSH
  end

  app <-->|native CLI / execution + cleanup evidence| upstream

  classDef host fill:#f5f7fa,stroke:#8a9aa8,color:#263e4e,stroke-width:1.5px
  classDef bridge fill:#173d50,stroke:#173d50,color:#ffffff,stroke-width:2px
  classDef native fill:#eaf4f0,stroke:#5d9385,color:#234d43,stroke-width:1.5px
  classDef workload fill:#fff4e9,stroke:#c2935f,color:#664625,stroke-width:1.5px
  class Host host
  class Bridge bridge
  class Native native
  class DSH workload
  style app fill:#fbfcfe,stroke:#b0bdc8,stroke-width:1px
  style upstream fill:#f7fbf9,stroke:#a3c1b7,stroke-width:1px
