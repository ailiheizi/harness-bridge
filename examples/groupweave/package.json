{
  "name": "groupweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node -e \"require('node:fs').accessSync('patches/file-type+16.5.4.patch')\" && patch-package --error-on-fail",
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "start:koishi": "tsx src/server/koishi-index.ts",
    "build": "tsc --noEmit && vite build",
    "maintenance": "tsx src/server/maintenance.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@actweave/harness-bridge": "file:../..",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-skill": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@grammyjs/ratelimiter": "1.2.1",
    "@grammyjs/runner": "2.0.3",
    "@koishijs/loader": "4.6.11",
    "@koishijs/plugin-adapter-telegram": "4.5.11",
    "@koishijs/plugin-database-sqlite": "4.7.0",
    "@koishijs/plugin-echo": "2.2.5",
    "@koishijs/plugin-help": "2.4.6",
    "@koishijs/plugin-http": "0.6.3",
    "@koishijs/plugin-proxy-agent": "^0.3.3",
    "@tma.js/bridge": "2.3.3",
    "@tma.js/init-data-node": "2.0.8",
    "axios": "1.16.1",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "koishi": "4.18.11",
    "koishi-plugin-ffmpeg": "1.1.0",
    "koishi-plugin-markdown-to-image-service": "2.7.0",
    "koishi-plugin-puppeteer": "3.9.0",
    "koishi-plugin-rss": "3.0.1",
    "koishi-plugin-schedule": "5.0.1",
    "koishi-plugin-video-parser-all": "1.7.7",
    "koishi-plugin-video-to-gif": "1.2.2",
    "lucide-react": "1.52.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "patch-package": "8.0.1",
