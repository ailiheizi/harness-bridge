# Use 0 for no Telegram receiver. Set to 1 only for a real Telegram bot.
ENABLE_TELEGRAM=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Persistent runtime data directory used by the native entry.
DATA_DIR=./data
HOST=127.0.0.1
PORT=4318
# Optional Node.js 26 native HTTP(S) environment proxy support. Off by default.
NODE_USE_ENV_PROXY=0
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
# Required by compose.koishi.yaml: exact public HTTPS origin, no path.
PUBLIC_ORIGIN=
MAX_ACTIVE_TASKS=2
# Reminder dates and daily times use this deployment timezone.
TZ=Asia/Shanghai

# Optional native AI: one-turn Q&A and summary via the existing Docker/DSH Bridge.
# ENABLE_AI=1 requires an absolute protected .mjs deployment binding with real
# provider budget/usage receipts. A model API key alone is not this binding.
ENABLE_AI=0
SANDBOX_AI_BINDING_MODULE=

# Optional /v2g and fixed media conversion commands. Docker compose installs FFmpeg
# when enabled; local execution uses this administrator-selected binary.
ENABLE_MEDIA=0
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional Markdown rendering uses the upstream plugin + an existing browser.
# Keep disabled until Chromium can launch with its sandbox in your deployment.
ENABLE_RENDER=0
RENDER_BROWSER_PATH=

# Optional manual /parse, directly using the pinned yt-dlp extractor.
ENABLE_SITE_PARSER=0
SITE_PARSER_YTDLP_PATH=yt-dlp
# Optional per-site Netscape cookie files, read-only mounted and kept private.
BILIBILI_COOKIES_FILE=
DOUYIN_COOKIES_FILE=
# Alternative only: explicitly configure both fields to use a remote parser API.
SITE_PARSER_API_URL=
SITE_PARSER_API_KEY=
