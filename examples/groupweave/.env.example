# Local preview: opaque server-issued synthetic identities, loopback publication.
APP_MODE=preview
PORT=4318
HOST=127.0.0.1
DATA_DIR=./data
MAX_ACTIVE_TASKS=2
# Real Telegram mode: register the bot as a group admin and configure HTTPS Mini App.
# Set APP_MODE=telegram; PUBLIC_ORIGIN must be one exact HTTPS origin without path.
PUBLIC_ORIGIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Default off; only app-specific credentials are accepted. Never auto-reads user profiles.
ENABLE_AI=0
DEEPSEEK_API_KEY=
# Optional private antiad inference; default bot image needs no Python.
# Build ENABLE_ANTIAD_RUNTIME=1 and mount an administrator-reviewed read-only model.
# joblib/pickle must never be uploaded or chosen by group users or AI.
ENABLE_ANTIAD=0
ANTIAD_PYTHON_PATH=/opt/antiad-venv/bin/python
ANTIAD_MODEL_PATH=
